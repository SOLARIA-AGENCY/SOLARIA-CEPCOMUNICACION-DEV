{
  "name": "solaria-cepcomunicacion",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Centro especializado en comunicación corporativa, marketing digital y estrategias de branding",
  "keywords": [
    "solaria-agency",
    "vite-template",
    "react",
    "typescript",
    "tailwindcss",
    "corporate-website"
  ],
  "author": {
    "name": "SOLARIA.AGENCY",
    "email": "hello@solaria.agency",
    "url": "https://solaria.agency"
  },
  "homepage": "https://cepcomunicacion.com",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=8.0.0"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "node server-dev.js",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:run:ci": "CI=true TZ=UTC FORCE_COLOR=0 vitest run --reporter=basic",
    "test:snapshots": "CI=true TZ=UTC vitest run --reporter=basic --no-coverage",
    "test:snapshots:update": "CI=true TZ=UTC vitest run --update-snapshots",
    "test:coverage": "vitest --coverage",
    "test:coverage:ci": "CI=true TZ=UTC FORCE_COLOR=0 vitest --coverage --reporter=basic",
    "test:watch": "vitest --watch",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 50",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "type-check": "tsc --noEmit",
    "audit:security": "npm audit --audit-level critical --json",
    "audit:fix": "npm audit fix",
    "compose:report": "tsx scripts/composeReport.ts",
    "predeploy": "npm run test:run && npm run lint && npm run build",
    "deploy": "echo 'Deployment ready'",
    "clean": "rm -rf dist coverage node_modules/.cache",
    "reinstall": "rm -rf node_modules package-lock.json && npm install",
    "prepare": "husky || true",
    "pre-commit": "TZ=UTC CI=true npm run test:run && npm run lint && npm run build",
    "pre-deploy": "npm run pre-commit && echo '✅ Ready for deployment!'",
    "safe-push": "npm run pre-deploy && git push",
    "test:e2e": "PLAYWRIGHT_USE_PRODUCTION=true playwright test",
    "test:e2e:local": "playwright test",
    "test:e2e:staging": "playwright test --config=playwright.config.staging.ts",
    "test:e2e:production": "PLAYWRIGHT_USE_PRODUCTION=true playwright test --config=playwright.config.staging.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "install:playwright": "playwright install",
    "ci:test": "npm run lint && npm run type-check && npm run test:run:ci && npm run test:e2e",
    "ci:build": "CI=true NODE_ENV=production TZ=UTC npm run build && npm run test:e2e:staging",
    "ci:test:full": "npm run test:coverage:ci && npm run lint && npm run type-check",
    "campaigns:list": "node scripts/manage-campaigns.cjs list",
    "campaigns:status": "node scripts/manage-campaigns.cjs status",
    "campaigns:analytics": "node scripts/manage-campaigns.cjs analytics",
    "campaigns:help": "node scripts/manage-campaigns.cjs help"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@tailwindcss/postcss": "^4.1.10",
    "@tanstack/react-query": "^5.17.0",
    "@types/leaflet": "^1.9.19",
    "@types/react-router-dom": "^5.3.3",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "dotenv": "^17.0.0",
    "express": "^5.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.536.0",
    "nodemailer": "^7.0.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.6.2",
    "resend": "^5.0.0",
    "supermemory": "^3.0.0-alpha.19"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@loadable/component": "^5.16.7",
    "@playwright/test": "^1.54.2",
    "@tailwindcss/typography": "^0.5.16",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.1.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^24.0.1",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.3",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.0",
    "cypress": "^14.4.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.34",
    "puppeteer": "^24.10.0",
    "rollup-plugin-visualizer": "^6.0.3",
    "sharp": "^0.34.3",
    "tailwindcss": "^4.1.10",
    "terser": "^5.43.1",
    "tsx": "^4.20.1",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.3.5",
    "vite-bundle-analyzer": "^1.1.0",
    "vitest": "^3.2.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SOLARIA-AGENCY/solaria-cepcomunicacion.git"
  }
}
