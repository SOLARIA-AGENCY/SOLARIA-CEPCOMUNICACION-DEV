{
  "name": "solaria-cepcomunicacion",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Centro especializado en comunicación corporativa, marketing digital y estrategias de branding",
  "keywords": [
    "solaria-agency",
    "vite-template",
    "react",
    "typescript",
    "tailwindcss",
    "corporate-website"
  ],
  "author": {
    "name": "SOLARIA.AGENCY",
    "email": "hello@solaria.agency",
    "url": "https://solaria.agency"
  },
  "homepage": "https://solaria-cepcomunicacion.netlify.app",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=8.0.0"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "node server-dev.js",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest --coverage",
    "test:watch": "vitest --watch",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 20",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "type-check": "tsc --noEmit",
    "audit:security": "npm audit --audit-level critical --json",
    "audit:fix": "npm audit fix",
    "compose:report": "tsx scripts/composeReport.ts",
    "predeploy": "npm run test:run && npm run lint && npm run build",
    "deploy": "echo 'Deployment ready'",
    "clean": "rm -rf dist coverage node_modules/.cache",
    "reinstall": "rm -rf node_modules package-lock.json && npm install",
    "prepare": "husky",
    "pre-commit": "npm run test:run && npm run lint && npm run build",
    "pre-deploy": "npm run pre-commit && echo '✅ Ready for deployment!'",
    "safe-push": "npm run pre-deploy && git push",
    "campaigns:list": "node scripts/manage-campaigns.cjs list",
    "campaigns:status": "node scripts/manage-campaigns.cjs status",
    "campaigns:analytics": "node scripts/manage-campaigns.cjs analytics",
    "campaigns:help": "node scripts/manage-campaigns.cjs help"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@tailwindcss/postcss": "^4.1.10",
    "@tanstack/react-query": "^5.17.0",
    "@types/leaflet": "^1.9.19",
    "@types/react-router-dom": "^5.3.3",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "dotenv": "^17.0.0",
    "express": "^5.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.522.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-helmet-async": "^2.0.5",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.6.2",
    "resend": "^4.6.0",
    "supermemory": "^3.0.0-alpha.19"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@netlify/functions": "^4.1.2",
    "@playwright/test": "^1.53.0",
    "@tailwindcss/typography": "^0.5.16",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.1.3",
    "@testing-library/react": "^16.3.0",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^24.0.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/coverage-v8": "^3.2.3",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.0",
    "cypress": "^14.4.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "playwright": "^1.53.0",
    "postcss": "^8.4.34",
    "puppeteer": "^24.10.0",
    "tailwindcss": "^4.1.10",
    "tsx": "^4.20.1",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SOLARIA-AGENCY/solaria-cepcomunicacion.git"
  }
}
