# ================================================================
# VARIABLES DE ENTORNO PRODUCCIÓN - CEPCOMUNICACION.COM API
# Configuración para VPS Hostinger
# ================================================================

# Configuración del servidor
NODE_ENV=production
PORT=3001

# Configuración Gmail SMTP - USAR SECRETS MANAGER
# ⚠️ NUNCA HARDCODEAR CREDENCIALES - USAR VARIABLES DE ENTORNO SEGURAS
GMAIL_EMAIL=${GMAIL_EMAIL_SECRET}
GMAIL_APP_PASSWORD=${GMAIL_PASSWORD_SECRET}

# Configuración de seguridad
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=10

# Configuración de CORS - Dominios permitidos
ALLOWED_ORIGINS=https://www.cepcomunicacion.com,https://cepcomunicacion.com

# Configuración de logs
LOG_LEVEL=info
LOG_FILE=/var/log/cepapi/app.log

# Configuración PM2
PM2_INSTANCES=1
PM2_MAX_MEMORY=512M

# Configuración adicional
TIMEZONE=Europe/Madrid