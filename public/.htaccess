RewriteEngine On

# Don't redirect files with common extensions
RewriteCond %{REQUEST_URI} \.(css|js|png|jpg|jpeg|gif|svg|ico|pdf|txt|xml|json|woff|woff2|ttf|eot)$ [NC]
RewriteRule .* - [L]

# Handle Angular and React Router
# If the request is for a directory or file that exists, serve it directly
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# 🎯 RUTAS DIRECTAS (Facebook Ads) - Campañas Activas
RewriteRule ^quiromasaje-nivel2-norte/?$ /index.html [L]
RewriteRule ^auxiliar-farmacia-dermo-norte/?$ /index.html [L]

# 🔄 RUTAS DIRECTAS (Facebook Ads) - Preparadas para Activación  
RewriteRule ^adiestramiento-canino-norte/?$ /index.html [L]
RewriteRule ^agente-funerario-santacruz/?$ /index.html [L]

# 🌐 RUTAS SEMÁNTICAS (SEO/Orgánico) - Campañas Activas
RewriteRule ^cursos/quiromasaje-nivel2-norte/?$ /index.html [L]
RewriteRule ^cursos/auxiliar-farmacia-dermo-norte/?$ /index.html [L]

# 🌐 RUTAS SEMÁNTICAS (SEO/Orgánico) - Preparadas para Activación
RewriteRule ^cursos/adiestramiento-canino-norte/?$ /index.html [L]
RewriteRule ^cursos/agente-funerario-santacruz/?$ /index.html [L]

# 💼 RUTAS CURSOS EMPLEO (SEPE) - CRÍTICAS PARA SEO
RewriteRule ^cursos-empleo/prevencion-riesgos-ambientales-ocupados/?$ /index.html [L]
RewriteRule ^prevencion-riesgos-ambientales-ocupados/?$ /index.html [L]
RewriteRule ^curso-ocupado/PRO-OCUP-PREV-RIESGOS-25/?$ /index.html [L]

# 📚 RUTAS LEGACY - Cursos Existentes
RewriteRule ^auxiliar-clinico-veterinario-norte/?$ /index.html [L]
RewriteRule ^auxiliar-clinico-veterinario-santacruz/?$ /index.html [L]
RewriteRule ^auxiliar-clinicas-esteticas-santacruz/?$ /index.html [L]
RewriteRule ^auxiliar-enfermeria-norte/?$ /index.html [L]
RewriteRule ^auxiliar-enfermeria-santacruz/?$ /index.html [L]
RewriteRule ^auxiliar-farmacia-parafarmacia-norte/?$ /index.html [L]
RewriteRule ^auxiliar-farmacia-parafarmacia-santacruz/?$ /index.html [L]
RewriteRule ^auxiliar-odontologia-periodoncia-santacruz/?$ /index.html [L]
RewriteRule ^dietetica-nutricion-santacruz/?$ /index.html [L]
RewriteRule ^peluqueria-canina-norte/?$ /index.html [L]
RewriteRule ^quiromasaje-nivel1-norte/?$ /index.html [L]
RewriteRule ^quiromasaje-nivel2-santacruz/?$ /index.html [L]
RewriteRule ^cfgs-higiene-bucodental-santacruz/?$ /index.html [L]
RewriteRule ^cfgm-farmacia-parafarmacia-santacruz/?$ /index.html [L]
RewriteRule ^adiestramiento-canino/?$ /index.html [L]

# Basic pages
RewriteRule ^cursos/?$ /index.html [L]
RewriteRule ^todos-los-cursos/?$ /index.html [L]
RewriteRule ^contacto/?$ /index.html [L]
RewriteRule ^aviso-legal/?$ /index.html [L]
RewriteRule ^politica-privacidad/?$ /index.html [L]
RewriteRule ^politica-cookies/?$ /index.html [L]
RewriteRule ^proteccion-datos/?$ /index.html [L]

# Fallback: Only redirect non-file requests (SPA routes)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ /index.html [L]

# Security headers
<IfModule mod_headers.c>
    Header always set X-Frame-Options DENY
    Header always set X-Content-Type-Options nosniff
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "no-referrer-when-downgrade"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://formsubmit.co; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://formsubmit.co;"
</IfModule>

# Gzip compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
</IfModule>

# Cache control
<IfModule mod_expires.c>
    ExpiresActive on
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>