# 🌑 SHADOW-DEVOPS CI Environment Configuration
# Temporal consistency and deterministic testing

# Core CI variables
CI=true
NODE_ENV=test
TZ=UTC

# Test configuration
VITEST_REPORTER=basic
FORCE_COLOR=0

# Build configuration
BUILD_DETERMINISTIC=true
SOURCE_MAP=false

# Network timeouts for stability
NETWORK_TIMEOUT=30000
TEST_TIMEOUT=10000

# Email testing (using FormSubmit proxy)
VITE_NOTIFICATION_EMAIL=agency.solaria@gmail.com
VITE_FORMSUBMIT_PROXY_URL=http://localhost:3001/api/formsubmit-proxy
VITE_API_BASE_URL=https://www.cepcomunicacion.com

# Prevent temporal drift in snapshots
SNAPSHOT_FIXED_DATE=2025-01-15T10:00:00.000Z