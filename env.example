# SOLARIA-VITE-TEMPLATE - Environment Variables

# Site Configuration
VITE_SITE_URL=https://your-site.netlify.app
VITE_SITE_NAME=Your Company
VITE_SITE_DESCRIPTION=Modern corporate website built with SOLARIA template

# API Configuration
VITE_API_BASE_URL=https://api.yourcompany.com
VITE_API_VERSION=v1

# Features
VITE_DASHBOARD_ENABLED=true
VITE_ANALYTICS_ENABLED=false

# Contact Information
VITE_CONTACT_EMAIL=contact@yourcompany.com
VITE_CONTACT_PHONE=+1-555-0123

# Lead Notifications (CEP Formación)
VITE_NOTIFICATION_EMAIL=agency.solaria@gmail.com
VITE_FORMSUBMIT_ENDPOINT=https://formsubmit.co/ajax/agency.solaria@gmail.com

# Email Service Configuration
# Resend API Key (para producción) - Opcional, usa FormSubmit como fallback
RESEND_API_KEY=your_resend_api_key_here
VITE_RESEND_API_KEY=your_resend_api_key_here

# Mailchimp API Configuration
MAILCHIMP_API_KEY=YOUR_MAILCHIMP_API_KEY_HERE
MAILCHIMP_SERVER_PREFIX=YOUR_MAILCHIMP_SERVER_PREFIX
MAILCHIMP_AUDIENCE_ID=YOUR_MAILCHIMP_AUDIENCE_ID_HERE

# Brevo API Configuration
BREVO_API_KEY=YOUR_BREVO_API_KEY_HERE

# Social Media
VITE_SOCIAL_LINKEDIN=https://linkedin.com/company/yourcompany
VITE_SOCIAL_TWITTER=https://twitter.com/yourcompany

# Environment Configuration
NODE_ENV=production

# Analytics (si fuera necesario)
VITE_GA_TRACKING_ID=
VITE_GTM_ID=

# Facebook Pixel & Conversions API Configuration
FB_PIXEL_ID=1189071876088388
FB_API_VERSION=v23.0
FB_ACCESS_TOKEN=YOUR_FB_ACCESS_TOKEN_HERE
FB_ENDPOINT=https://graph.facebook.com/v23.0/${FB_PIXEL_ID}/events?access_token=${FB_ACCESS_TOKEN}

# n8n Integration
FB_N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/facebook-conversions

# Development Configuration
VITE_DEV_MODE=false

# Clave de API para el servicio Supermemory
VITE_SUPERMEMORY_API_KEY=