# SOLARIA-VITE-TEMPLATE - Environment Variables

# Site Configuration
VITE_SITE_URL=https://your-site.netlify.app
VITE_SITE_NAME=Your Company
VITE_SITE_DESCRIPTION=Modern corporate website built with SOLARIA template

# API Configuration
VITE_API_BASE_URL=https://api.yourcompany.com
VITE_API_VERSION=v1

# Features
VITE_DASHBOARD_ENABLED=true
VITE_ANALYTICS_ENABLED=false

# Contact Information
VITE_CONTACT_EMAIL=contact@yourcompany.com
VITE_CONTACT_PHONE=+1-555-0123

# Social Media
VITE_SOCIAL_LINKEDIN=https://linkedin.com/company/yourcompany
VITE_SOCIAL_TWITTER=https://twitter.com/yourcompany

# Environment Configuration
NODE_ENV=production

# Analytics (si fuera necesario)
VITE_GA_TRACKING_ID=
VITE_GTM_ID=

# Development Configuration
VITE_DEV_MODE=false 