#!/usr/bin/env sh
. "$(dirname "$0")/_/husky.sh"

echo "🛡️ GUARDIAN-PROTOCOL: Pre-commit security validation"

# Force UTC timezone for deterministic tests
export TZ=UTC
export CI=true

echo "⚡ Running deterministic test suite..."
npm run test:run

if [ $? -ne 0 ]; then
  echo "❌ SECURITY BREACH: Tests failing - COMMIT BLOCKED"
  echo "🔒 GUARDIAN-PROTOCOL: Fix all tests before commit"
  exit 1
fi

echo "✅ SNAPSHOT INTEGRITY VERIFIED"

echo "🔍 Running lint validation..."
npm run lint

if [ $? -ne 0 ]; then
  echo "❌ SECURITY BREACH: Lint errors detected - COMMIT BLOCKED"
  exit 1
fi

echo "🏗️ Running build validation..."
npm run build

if [ $? -ne 0 ]; then
  echo "❌ SECURITY BREACH: Build failed - COMMIT BLOCKED"
  exit 1
fi

echo "🛡️ GUARDIAN-PROTOCOL: All security checks passed - COMMIT AUTHORIZED"